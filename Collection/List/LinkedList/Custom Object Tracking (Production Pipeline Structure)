>>> Real-world applications do not just pass clean strings. They pass data wrappers (POJOs)
    >>> This architecture models a fast-shifting log-tracking monitor for microservices.

#File Name: LogMonitor

import java.util.LinkedList;

// Standard Enterprise Data Model representing a system event log
class LogPayload 
{
    String timestamp;
    String status;

    public LogPayload(String timestamp, String status)
    {
        this.timestamp = timestamp;
        this.status = status;
    }

    @Override
    public String toString()
    {
        return "[" + timestamp + " | Status: " + status + "]";
    }
}

public class LogMonitor {
    public static void main(String[] args) 
      {
        // LinkedList provides O(1) performance for head/tail operations in rolling monitors
        LinkedList<LogPayload> rollingLogs = new LinkedList<>();

        // Streaming incoming server logs into memory
        rollingLogs.add(new LogPayload("10:00:01 AM", "SUCCESS"));
        rollingLogs.add(new LogPayload("10:00:02 AM", "WARNING"));
        rollingLogs.add(new LogPayload("10:00:03 AM", "CRITICAL_ERROR"));

        System.out.println("--- Server Diagnostics Logs ---");
        for (LogPayload log : rollingLogs) {
            System.out.println(log);
        }

        // Drop the oldest diagnostic chunk from memory to manage heap footprint optimization
        LogPayload discardedLog = rollingLogs.removeFirst();
        System.out.println("\nArchived old memory footprint block: " + discardedLog);
    }
}

