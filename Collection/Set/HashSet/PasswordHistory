#Checking for Duplicate Passwords Before Saving

import java.util.HashSet;
import java.util.Set;

public class PasswordHistory {
    public static void main(String[] args)
{
        Set<String> previousPasswords = new HashSet<>();
        previousPasswords.add("ChaiTime123");
        previousPasswords.add("Cricket!45");
        previousPasswords.add("Mumbai7Ind");

        String newPassword = "Cricket!45";   // Ravi is trying to reuse this

        if (previousPasswords.contains(newPassword))
{
            System.out.println("Rejected: Ravi, you've used this password before.");
        } else {
            previousPasswords.add(newPassword);
            System.out.println("Password accepted and added to history.");
        }

        String secondAttempt = "Delhi#88Cap";
        if (previousPasswords.contains(secondAttempt)) 
{
            System.out.println("Rejected: duplicate.");
        } else {
            previousPasswords.add(secondAttempt);
            System.out.println("Password accepted and added to history.");
        }

        System.out.println("Stored passwords: " + previousPasswords);
    }
}

