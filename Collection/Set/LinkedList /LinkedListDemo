> LinkedList (Fast Insertions & Deletions)
    > Why use it: Under the hood, it links elements together like a chain
      > It works exactly like an ArrayList but is much faster when you frequently add or remove items from the middle or the beginning of the list.

 import java.util.LinkedList;
import java.util.List;

public class LinkedListDemo {
    public static void main(String[] args)
{
        // Using a linked chain structure for highly dynamic inventory modifications
        List<String> productChain = new LinkedList<>();

        productChain.add("Laptop");
        productChain.add("Mouse");
        
        // Simulating a real-time modification: insert an item at the absolute start
        productChain.add(0, "Keyboard");

      
        System.out.println("Current Stock Flow: " + productChain);
    }
}
  // Output: [Keyboard, Laptop, Mouse]
