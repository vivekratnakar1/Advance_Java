import java.util.HashMap;

public class HashMapTreeifyPOC {
    
    // Custom key class designed to cause intentional hash collisions
    static class CollidingKey {
        private final int id;

        public CollidingKey(int id) {
            this.id = id;
        }

        @Override
        public int hashCode() {
            // Forces every instance into the exact same bucket/bin
            return 42; 
        }

        @Override
        public boolean equals(Object obj) {
            if (this == obj) return true;
            if (obj == null || getClass() != obj.getClass()) return false;
            CollidingKey other = (CollidingKey) obj;
            return this.id == other.id;
        }
    }

    public static void main(String[] args) {
        // Default initial capacity is 16
        HashMap<CollidingKey, String> map = new HashMap<>();

        System.out.println("--- Simulating Elements Insertion ---");
        
        for (int i = 1; i <= 10; i++) {
            map.put(new CollidingKey(i), "Value_" + i);
            
            /* 
             * Internal Execution Flow:
             * - Elements 1 to 7: Added smoothly to a singly-linked list in the same bin.
             * - Element 8: The bin count hits the TREEIFY_THRESHOLD (8). 
             * - Check: The map examines if total capacity >= 64. 
             * - Action: Since the default capacity is 16 (which is < 64), Java skips treeification 
             *   and resizes (doubles) the array size to clear out the dense bucket.
             * - The list will only convert to a TreeNode structure once the overall capacity is 64+.
             */
            System.out.println("Inserted element " + i + " into the same bucket.");
        }
        
        System.out.println("\nExecution Complete: The bin count threshold of 8 dictates when to trigger " +
                           "the structural change, while the table capacity of 64 gates the actual treeification.");
    }
}
