                                                    mermaid
                                                    graph TD
                                                        Collection --> List
                                                        Collection --> Set
                                                        Collection --> Queue
                                                        
                                                        List --> ArrayList
                                                        List --> LinkedList
                                                        List --> Vector
                                                        
                                                        Set --> HashSet
